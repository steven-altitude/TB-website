<section class="page-hero">
  <p class="section-label">Equipo</p>
  <h1 class="page-hero-title">Asesores<br><em>Extranjeros</em></h1>
</section>

<section style="padding:7rem 8vw; background:var(--cream-light);">
  <p style="max-width:60ch; font-size:0.9rem; line-height:1.9; color:var(--charcoal-mid); margin-bottom:4rem;">
    Nuestra red internacional de asesores amplía nuestra capacidad en sectores especializados y mercados clave. Operamos oficinas corresponsales en Lima, Ciudad de México, Miami, Chile y Washington D.C.
  </p>

  <div class="team-grid-cards">
    {% for member in collections.asesores %}
      {% set delay = loop.index0 %}
      {% include "team-card.njk" %}
    {% endfor %}
  </div>

  <div style="margin-top:5rem; padding-top:4rem; border-top:1px solid rgba(44,43,40,0.1);">
    <p class="section-label">Socio Estratégico</p>
    <h2 class="section-title" style="margin-bottom:1.5rem;"><a href="https://www.excomslt.com/" target="_blank" rel="noopener" style="color:inherit; text-decoration:none;"><em>Excom Solutions</em></a></h2>
    <p style="font-size:0.9rem; line-height:1.9; color:var(--charcoal-mid); max-width:55ch;">Consultoría especializada en comercio internacional, identificación de oportunidades de negocio y promoción internacional global. Presencia en China, Alemania y España.</p>
    <a href="https://www.excomslt.com/" class="pillar-link" style="display:inline-block; margin-top:1rem; font-size:0.7rem;" target="_blank" rel="noopener">Visitar Excom Solutions &rarr;</a>
  </div>
</section>

<section style="padding:6rem 8vw; background:var(--charcoal);">
  <p class="section-label" style="color:var(--gold);">Alcance Global</p>
  <h2 style="font-family:var(--serif); font-size:clamp(1.8rem,3vw,3rem); font-weight:300; color:var(--cream-light); line-height:1.1; max-width:24ch; margin-bottom:2.5rem;">
    Corresponsales en <em style="color:var(--gold-light);">cinco ciudades</em>
  </h2>
  <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:1.5rem; max-width:700px;">
    {% set cities = [
      {city: "Lima", country: "Perú"},
      {city: "Ciudad de México", country: "México"},
      {city: "Miami", country: "EE.UU."},
      {city: "Washington D.C.", country: "EE.UU."},
      {city: "Chile", country: "Chile"}
    ] %}
    {% for item in cities %}
    <div>
      <p style="font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold); margin-bottom:0.3rem;">{{ item.country }}</p>
      <p style="font-size:0.85rem; color:rgba(237,233,224,0.8);">{{ item.city }}</p>
    </div>
    {% endfor %}
  </div>
</section>
